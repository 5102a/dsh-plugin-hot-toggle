{
  "name": "dsh-plugin-hot-toggle",
  "version": "0.1.3",
  "description": "Hot-toggle any installed plugin in DeepSeek Harness from the Web settings — instant apply, no restart, persisted. 在 DSH 设置页一键热启用/停用任意插件，立即生效、无需重启、状态持久化。",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "docs/screenshot-en.png",
    "docs/screenshot-zh.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node --test",
    "check": "node scripts/build.mjs && node --test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "hot-reload",
    "loader"
  ],
  "license": "MIT",
  "author": "5102a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5102a/dsh-plugin-hot-toggle.git"
  },
  "bugs": {
    "url": "https://github.com/5102a/dsh-plugin-hot-toggle/issues"
  },
  "homepage": "https://github.com/5102a/dsh-plugin-hot-toggle#readme",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  }
}
